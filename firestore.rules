rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function hasProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper: get user's role from their profile document
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper: get user's branch from their profile document
    function getUserBranch() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.branch;
    }

    // Role check helpers (safe with exists check)
    function isAdmin() {
      return hasProfile() && getUserRole() == 'admin';
    }

    function isVendor() {
      return hasProfile() && getUserRole() == 'vendedor';
    }

    function isClient() {
      return hasProfile() && getUserRole() == 'cliente';
    }

    // ═══ USERS collection ═══
    match /users/{userId} {
      // Owner can read their own; Admin can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // On creation, only role 'cliente' or 'admin' if no admin exists
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // User can update basic info without elevating role/branch; Admin can update everything
      allow update: if isAdmin() || (
        isOwner(userId) 
        && request.resource.data.role == resource.data.role 
        && request.resource.data.branch == resource.data.branch
      );
      
      allow delete: if isAdmin();
    }

    // ═══ BOATS collection ═══
    match /boats/{boatId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══ BRANDS collection ═══
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══ PLANS collection ═══
    match /plans/{planId} {
      allow read: if isAdmin()
        || (isVendor() && resource.data.branch == getUserBranch())
        || (isClient() && resource.data.clientUid == request.auth.uid);
      allow create, update: if isAdmin()
        || (isVendor() && request.resource.data.branch == getUserBranch());
      allow delete: if isAdmin();
    }

    // ═══ DOCUMENTS collection ═══
    match /documents/{docId} {
      allow read: if isAdmin()
        || (isVendor() && resource.data.branch == getUserBranch())
        || (isClient() && resource.data.clientUid == request.auth.uid);
      allow create, update: if isAdmin()
        || (isVendor() && request.resource.data.branch == getUserBranch());
      allow delete: if isAdmin();
    }
  }
}
