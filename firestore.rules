rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: verify if user is the single authorized Super Administrator
    function isSuperAdminEmail() {
      return isAuthenticated() 
        && request.auth.token.email != null 
        && (
          request.auth.token.email == 'arriolapablo.a@gmail.com' 
          || request.auth.token.email.lower() == 'arriolapablo.a@gmail.com'
        );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function hasProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper: get user's role from their profile document
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper: get user's branch from their profile document
    function getUserBranch() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.branch;
    }

    // Role check helpers: ONLY arriolapablo.a@gmail.com can ever be Admin!
    function isAdmin() {
      return isSuperAdminEmail() && hasProfile() && getUserRole() == 'admin';
    }

    function isVendor() {
      return hasProfile() && getUserRole() == 'vendedor';
    }

    function isClient() {
      return hasProfile() && getUserRole() == 'cliente';
    }

    // ═══ USERS collection ═══
    match /users/{userId} {
      // Owner can read their own profile; Admin can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // On creation: Only arriolapablo.a@gmail.com can be created with role 'admin'.
      // All other users must be created as 'cliente'.
      allow create: if isAuthenticated() && request.auth.uid == userId
        && (
          (request.resource.data.role == 'admin' && isSuperAdminEmail())
          || request.resource.data.role == 'cliente'
        );
      
      // On update: Admin can update, but cannot assign 'admin' to any other account.
      // Owner can update basic info without elevating role/branch.
      allow update: if (
        isAdmin() && (
          request.resource.data.role != 'admin' || (isOwner(userId) && isSuperAdminEmail())
        )
      ) || (
        isOwner(userId) 
        && request.resource.data.role == resource.data.role 
        && request.resource.data.branch == resource.data.branch
      );
      
      allow delete: if isAdmin() && !isOwner(userId);
    }

    // ═══ BOATS collection ═══
    match /boats/{boatId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══ BRANDS collection ═══
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══ PLANS collection ═══
    match /plans/{planId} {
      allow read: if isAdmin()
        || (isVendor() && resource.data.branch == getUserBranch())
        || (isClient() && resource.data.clientUid == request.auth.uid);
      allow create, update: if isAdmin()
        || (isVendor() && request.resource.data.branch == getUserBranch());
      allow delete: if isAdmin();
    }

    // ═══ DOCUMENTS collection ═══
    match /documents/{docId} {
      allow read: if isAdmin()
        || (isVendor() && resource.data.branch == getUserBranch())
        || (isClient() && resource.data.clientUid == request.auth.uid);
      allow create, update: if isAdmin()
        || (isVendor() && request.resource.data.branch == getUserBranch());
      allow delete: if isAdmin();
    }
  }
}
